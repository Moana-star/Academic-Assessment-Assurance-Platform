# Example only. Copy to .env for local development and never commit secrets.
DJANGO_SECRET_KEY=replace-with-a-long-random-local-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key private and stable; changing it makes encrypted face templates unreadable.
BIOMETRIC_ENCRYPTION_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DATABASE_URL=your_neon_connection_string